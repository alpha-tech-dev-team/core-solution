{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Telegram": {
    "BotToken": ""
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=atlas;Username=atlas;Password=atlas",
    "SeedOnStartup": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "SessionSettings": {
    "ExpiryMinutes": 30
  },
  "Identity": {
    "BaseUrl": "http://localhost:5257"
  }
}
