{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=alphadev_identity;Username=postgres;Password=admin"
  },
  "Jwt": {
    "Secret": "your_super_secret_key_at_least_32_chars",
    "Issuer": "alphadev-identity",
    "Audience": "alphadev"
  },
  "RateLimiting": {
    "TokenLimit": 5,
    "TokensPerPeriod": 5,
    "ReplenishmentPeriodSeconds": 60
  }
}
