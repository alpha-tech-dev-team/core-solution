{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Secret": "your_super_secret_key_at_least_32_chars",
    "Issuer": "alphadev-identity",
    "Audience": "alphadev"
  }
}
