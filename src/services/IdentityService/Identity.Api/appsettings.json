{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ClientApi": {
    "AtlasApiKey": ""
  },
  "Database": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Secret": "your_super_secret_key_at_least_32_chars",
    "Issuer": "alphadev-identity",
    "Audience": "alphadev"
  },
  "RateLimiting": {
    "TokenLimit": 5,
    "TokensPerPeriod": 5,
    "ReplenishmentPeriodSeconds": 60,
    "QueueLimit": 0,
    "AutoReplenishment": true,
    "Bot": {
      "TokenLimit": 120,
      "TokensPerPeriod": 120,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 0,
      "AutoReplenishment": true
    },
    "EmployeeDirectory": {
      "TokenLimit": 60,
      "TokensPerPeriod": 60,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 0,
      "AutoReplenishment": true
    }
  }
}
